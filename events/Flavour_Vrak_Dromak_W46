# 1. Buy the province?
country_event = {
	id = flavour_vrak_dromak.3
	title = flavour_vrak_dromak.3.t
	desc = flavour_vrak_dromak.3.d
	picture = DIPLOMACY_eventPicture
	
	fire_only_once = yes
	
	option = {
		name = flavour_vrak_dromak.3.a
		ai_chance = { factor = 75 }
		custom_tooltip = flavour_vrak_dromak.3.a.tt
		
		overlord = {
			country_event = { 
				id = flavour_vrak_dromak.4 
				days = 1
			}
		}
	}
	option = {
		name = flavour_vrak_dromak.3.b
		ai_chance = { factor = 25 }
		custom_tooltip = flavour_vrak_dromak.3.b.tt
		add_prestige = -5
	}
}

# 2. The offer (Fires for the Overlord. ROOT = Overlord, FROM = W46)
country_event = {
	id = flavour_vrak_dromak.4
	title = flavour_vrak_dromak.4.t
	desc = flavour_vrak_dromak.4.d
	picture = DIPLOMACY_eventPicture
	
	fire_only_once = yes
	is_triggered_only = yes
	
	# Option A: Overlord agrees to offer the province
	option = {
		name = flavour_vrak_dromak.4.a
		ai_chance = { factor = 100 }
		
		FROM = {
			country_event = { 
				id = flavour_vrak_dromak.5
				days = 1
			}
		}
	}
	# Option B: Overlord refuses to even make the offer
	option = {
		name = flavour_vrak_dromak.4.b 
		ai_chance = { factor = 0 }
		custom_tooltip = flavour_vrak_dromak.4.b.tt
		
		FROM = {
			country_event = { id = flavour_vrak_dromak.6 }
		}
	}
}

# 3. Overlord accept (Fires back for W46 - The Subject. ROOT = W46, FROM = Overlord)
country_event = {
	id = flavour_vrak_dromak.5
	title = flavour_vrak_dromak.5.t
	desc = flavour_vrak_dromak.5.d
	picture = DIPLOMACY_eventPicture
	
	fire_only_once = yes
	is_triggered_only = yes
	
	option = {
		name = flavour_vrak_dromak.5.a
		
		add_treasury = -100
		
		FROM = {
			add_treasury = 100
		}
		
		573 = {
			if = {
				limit = {
					owned_by = FROM      # Owned by the Overlord
					controlled_by = FROM # Controlled by the Overlord
				}
				cede_province = ROOT    # Given to W46
				add_core = ROOT         # W46 gets a core
				remove_core = FROM      # Overlord loses their core
			}
		}
	}
}

# 4. Overlord declines (Fires back for W46 - The Subject)
